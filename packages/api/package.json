{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -r npm:watch npm:start",
    "build": "tsc",
    "watch": "tsc -w",
    "clean": "rimraf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "test": "echo \"No tests yet...\"",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@azure/functions": "^4.0.0",
    "@electric-sql/pglite": "^0.4.3",
    "@hono/zod-validator": "^0.7.6",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.10",
    "postgres": "^3.4.8"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "rimraf": "^5.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  },
  "main": "dist/src/{index.js,functions/*.js}",
  "exports": {
    "./src/*": {
      "types": "./src/*"
    }
  }
}
