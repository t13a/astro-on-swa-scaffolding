---
import type { HTMLAttributes } from "astro/types";
import DataGrid from "./DataGrid.astro";
import { config } from "./AnnouncementsDataGrid.js";

interface Props extends HTMLAttributes<"div"> {}

const { ...rest } = Astro.props;
---

<announcements-data-grid-component>
  <DataGrid config={config} {...rest} />
</announcements-data-grid-component>

<script>
  import { DataGridComponent } from "./DataGrid.js";
  import { config } from "./AnnouncementsDataGrid.js";
  import { apiClient } from "../lib/api-client.js";
  import { createImplementor } from "../lib/data-grid-helper.js";

  class AnnouncementsDataGridComponent extends DataGridComponent {
    readonly config = config;
    readonly implementor = createImplementor<typeof config.fields>(
      apiClient.management.announcements.$get,
      apiClient.management.announcements.$post,
      apiClient.management.announcements[":id"].$put,
      apiClient.management.announcements[":id"].$delete,
    );
  }

  customElements.define(
    "announcements-data-grid-component",
    AnnouncementsDataGridComponent,
  );
</script>
